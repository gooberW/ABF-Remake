  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8c47ef5dd4717aa43bcfb01f91a4c2ed, type: 3}
  m_Name: Kyle Truth
  m_EditorClassIdentifier: 
  lines:
  - characterName: Kyle
    text: Kevin and I were playing and he told me to steal your purse.
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Kyle
    text: "I didn\u2019t want to but he said you wouldn\u2019t mind so I did it and-"
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Mom
    text: "Oh Kyle, come here, it\u2019s ok\u2026"
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Mom
    text: "Honey, it\u2019s okay. "
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Mom
    text: "But you have to accept that your brother is gone\u2026"
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Kyle
    text: "No he\u2019s not\u2026"
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Kyle
    text: "He\u2019s right here."
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Mom
    text: What?
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Mom
    text: What did you just say?
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Kyle
    text: Nothing, Mom.
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Mom
    text: Oh, can you do me a favour?
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Mom
    text: Can you help me look for my car keys?
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Mom
    text: "I lost them earlier today and don\u2019t know where they are\u2026"
    voiceClip: {fileID: 0}
    audioSourceKey: 
  - characterName: Kyle
    text: Okay!
    voiceClip: {fileID: 0}
    audioSourceKey: 
  nextDialogue: {fileID: 0}
