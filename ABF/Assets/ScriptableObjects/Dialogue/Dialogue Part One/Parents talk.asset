  m_Script: {fileID: 11500000, guid: 8c47ef5dd4717aa43bcfb01f91a4c2ed, type: 3}
  m_Name: Parents talk
  m_EditorClassIdentifier: 
  lines:
  - characterName: Mom
    text: "Can\u2019t believe it\u2019s been 5 months\u2026"
  - characterName: Dad
    text: "I think Kyle still doesn't truly believe he\u2019s gone\u2026"
  - characterName: Mom
    text: 'How could he? '
  - characterName: Mom
    text: "He\u2019s just a kid\u2026"
  - characterName: Mom
    text: "Kids aren\u2019t meant to deal with things like this\u2026"
  - characterName: Dad
    text: "I know baby, I know\u2026"
  - characterName: Mom
    text: How could I be so dumb, why was I in front of him?
  - characterName: Mom
    text: "Why didn\u2019t I wait for him?"
  - characterName: Mom
    text: " I\u2019m so stupid!"
  nextDialogue: {fileID: 11400000, guid: 30ed4ec028764b343a8ebd94d48d7933, type: 2}
